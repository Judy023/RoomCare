# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Database (defaults shown)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=RoomCare
# DB_USER=root
# DB_PASS=
# SESSION_SECRET=change-me

# ── PMS integration ────────────────────────────────────────────────
# mock (default) | live | disabled
PMS_MODE=mock
# Token the PMS must send in the X-PMS-Token header (required when NODE_ENV=production)
PMS_WEBHOOK_TOKEN=
# Where RoomCare POSTs CleaningCompleted events in live mode
PMS_OUTBOUND_URL=
# Sent as "Authorization: Bearer <token>" to the PMS
PMS_OUTBOUND_TOKEN=
# Optional: HMAC-SHA256 signature of the body in the X-RoomCare-Signature header
PMS_SIGNING_SECRET=
# task_completed (default) | inspection_passed
PMS_NOTIFY_ON=task_completed
# FrontDeskFlow → RoomCare key for /api/integrations/frontdesk/* (falls back to PMS_WEBHOOK_TOKEN)
FRONTDESK_API_KEY=
# Outgoing request shape — set to match the FrontDeskFlow API once it is published
# PMS_OUTBOUND_METHOD=POST
# PMS_OUTBOUND_AUTH_HEADER=Authorization
# PMS_OUTBOUND_AUTH_SCHEME=Bearer
# PMS_TIMEOUT_MS=10000
# PMS_MAX_ATTEMPTS=6
# PMS_MOCK_FAIL=1   # testing only: makes mock deliveries fail

# ── FrontDesk API (see docs/frontdeskflow-api.md) ────────────────────────────────────
# FRONTDESK_API_BASE_URL=https://<frontdesk-host>/api/v1/integrations
# FrontDesk's HOUSEKEEPING_API_KEY (sent as X-Api-Key)
# FRONTDESK_API_TOKEN=
# FrontDesk's HOUSEKEEPING_INBOUND_SECRET: RoomCare signs every POST with it
# FRONTDESK_API_SIGNING_SECRET=
# FrontDesk's HOUSEKEEPING_WEBHOOK_SECRET: verifies webhooks sent to POST /api/frontdesk/webhook
# FRONTDESK_WEBHOOK_SECRET=
# FRONTDESK_API_TIMEOUT_MS=10000
# FRONTDESK_SYNC_INTERVAL_MINUTES=5            # 0 / unset = no automatic room sync (use: npm run sync:frontdesk)
# Release rooms only after RoomCare's inspection (FrontDesk makes a room available on COMPLETED):
# PMS_NOTIFY_ON=inspection_passed
# FRONTDESK_STATUS_WORDS={"Clean":null,"Inspected":"COMPLETED"}

# ── HR/Payroll integration ─────────────────────────────────────────
# Token HR/Payroll must send as "Authorization: Bearer <token>" (or X-HR-Token)
HR_API_TOKEN=
# StaffPay → RoomCare key for /api/integrations/staffpay/* (falls back to HR_API_TOKEN). Must differ from FRONTDESK_API_KEY.
STAFFPAY_API_KEY=
