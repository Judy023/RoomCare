# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Database (defaults shown)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=RoomCare
# DB_USER=root
# DB_PASS=
# SESSION_SECRET=change-me

# ── PMS integration ────────────────────────────────────────────────
# mock (default) | live | disabled
PMS_MODE=mock
# Token the PMS must send in the X-PMS-Token header (required when NODE_ENV=production)
PMS_WEBHOOK_TOKEN=
# Where RoomCare POSTs CleaningCompleted events in live mode
PMS_OUTBOUND_URL=
# Sent as "Authorization: Bearer <token>" to the PMS
PMS_OUTBOUND_TOKEN=
# Optional: HMAC-SHA256 signature of the body in the X-RoomCare-Signature header
PMS_SIGNING_SECRET=
# task_completed (default) | inspection_passed
PMS_NOTIFY_ON=task_completed
# PMS_TIMEOUT_MS=10000
# PMS_MAX_ATTEMPTS=6
# PMS_MOCK_FAIL=1   # testing only: makes mock deliveries fail

# ── HR/Payroll integration ─────────────────────────────────────────
# Token HR/Payroll must send as "Authorization: Bearer <token>" (or X-HR-Token)
HR_API_TOKEN=
