# Set these in Hostinger hPanel → Node.js app → Environment variables (do NOT upload a real .env in the zip).
NODE_ENV=production
# SESSION_SECRET: run  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Hostinger MySQL (hPanel → Databases). Names are prefixed, e.g. u123456789_roomcare
# All four of host, name, user and password are required in production (no root/empty-password fallback).
# Also accepted: DB_USERNAME for DB_USER, DB_PASSWORD for DB_PASS, DATABASE_* for any of them.
# DB_HOST: the MySQL hostname shown in hPanel (e.g. srvNNNN.hstgr.io), or localhost if the app runs on the same server.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# First admin, used once by `npm run setup:production`; remove ADMIN_PASSWORD afterwards
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── FrontDesk connection (values come from the FrontDesk system's admin/developer) ──
PMS_MODE=live
FRONTDESK_API_BASE_URL=https://<frontdesk-domain>/api/v1/integrations
FRONTDESK_API_TOKEN=
FRONTDESK_API_SIGNING_SECRET=
FRONTDESK_WEBHOOK_SECRET=
FRONTDESK_ROOM_AUTHORITY=frontdesk
FRONTDESK_SYNC_INTERVAL_MINUTES=5
PMS_NOTIFY_ON=task_completed

# Keys for FrontDesk's direct calls to /api/integrations/frontdesk/* and StaffPay's to /staffpay/* (must differ)
FRONTDESK_API_KEY=
STAFFPAY_API_KEY=
PMS_WEBHOOK_TOKEN=
HR_API_TOKEN=
