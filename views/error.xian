{{> head}}
<div class="card mx-auto max-w-lg text-center sm:mt-10 sm:p-10">
  <span class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-terracotta-soft text-terracotta">
    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
  </span>
  <h1 class="font-display text-2xl font-semibold tracking-tight">{{title}}</h1>
  <p class="mt-3 muted leading-relaxed">{{message}}</p>
  <div class="mt-7 flex justify-center gap-2">
    <a href="javascript:history.back()" class="btn-secondary">Go back</a>
    <a href="/dashboard" class="btn">Home</a>
  </div>
</div>
{{> footer}}
