{{> head}}
<div class="card mx-auto max-w-md text-center sm:mt-10 sm:p-10">
  <span class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-gold-soft text-gold-deep">
    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
  </span>
  <h1 class="font-display text-2xl font-semibold tracking-tight">Forgot your password?</h1>
  <p class="mt-3 muted leading-relaxed">Passwords are reset by your System Admin. Ask them to set a new one from <b class="text-forest">Users</b>, then sign in and keep it private.</p>
  <a href="/login" class="btn mt-7 w-full py-3">Back to sign in</a>
</div>
{{> footer}}
