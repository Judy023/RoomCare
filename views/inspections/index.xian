{{> head}}
<div class="page-header">
  <div>
    <p class="eyebrow">Quality control</p>
    <h1 class="page-title">Inspections</h1>
    <p class="page-sub">Rooms appear here once they are cleaned and every repair on them is resolved.</p>
  </div>
</div>

<section class="mb-8">
  <h2 class="section-title">Ready for inspection <span class="count">{{pending.length}}</span></h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {{#each pending}}
    <div class="flex flex-col rounded-2xl border p-5 shadow-soft {{roomColor status}}">
      <div class="flex items-start justify-between gap-2">
        <div class="font-display text-2xl font-semibold">Room {{roomNo}}</div>
        {{#unless (hiddenStatus status)}}<span class="rounded-full bg-white/70 px-2 py-0.5 text-[11px] font-semibold">{{label status}}</span>{{/unless}}
      </div>
      <div class="mb-2 text-xs opacity-80">{{type}} · Floor {{floor}}</div>
      <div class="mb-4 space-y-0.5">
      {{#each tasks}}<div class="mt-1 text-xs">🧹 {{title}}{{#if housekeeper.name}} by {{housekeeper.name}}{{/if}}</div>{{/each}}
      {{#each workOrders}}<div class="mt-0.5 text-xs">🔧 {{code}} {{category}} — resolved</div>{{/each}}
      </div>
      <a href="/inspections/new?roomId={{id}}" class="btn btn-sm mt-auto w-full js-open-inspect" data-dialog="inspect-{{id}}">Inspect</a>
    </div>

    <dialog id="inspect-{{id}}" class="js-inspect-dialog dialog max-w-lg">
      <form method="POST" action="/inspections" class="flex max-h-[85vh] flex-col">
        <input type="hidden" name="roomId" value="{{id}}">
        <div class="flex items-start justify-between gap-3 border-b border-line px-6 py-5">
          <div>
            <h2 class="font-display text-xl font-semibold">Inspect Room {{roomNo}}</h2>
            <p class="muted">{{type}} · Floor {{floor}}</p>
          </div>
          <button type="button" class="js-close-inspect icon-btn text-xl leading-none" aria-label="Close">×</button>
        </div>

        <div class="space-y-5 overflow-y-auto overscroll-contain px-6 py-5">
          {{#if tasks.length}}
          <div class="space-y-1 rounded-xl bg-sage px-4 py-3 text-sm">
            {{#each tasks}}<p>🧹 <b>{{title}}</b> ({{code}}){{#if housekeeper.name}} by {{housekeeper.name}}{{/if}}</p>{{/each}}
            {{#each workOrders}}<p>🔧 {{code}} {{category}}: {{description}} — resolved</p>{{/each}}
          </div>
          {{/if}}

          <fieldset>
            <legend class="section-title">Checklist <span class="font-normal muted">— tick every item that passes</span></legend>
            <div class="space-y-2">
              {{#each @root.checklist}}
              <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line px-4 py-3 transition hover:border-moss/30 hover:bg-ivory has-[:checked]:border-leaf/30 has-[:checked]:bg-leaf-soft">
                <input type="checkbox" name="items" value="{{key}}" class="h-5 w-5 accent-forest js-item">
                <span class="flex-1 text-sm">{{this.label}}</span>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-moss/70">{{kind}}</span>
              </label>
              {{/each}}
            </div>
          </fieldset>

          <div>
            <label class="label" for="remarks-{{id}}">Remarks</label>
            <textarea id="remarks-{{id}}" name="remarks" rows="2" class="input" placeholder="What needs fixing if it failed"></textarea>
          </div>

          <div class="js-verdict notice-danger">Result: <b>FAIL</b> — unticked items send the room back.</div>
        </div>

        <div class="flex gap-2 rounded-b-2xl border-t border-line bg-ivory px-6 py-4">
          <button type="button" class="btn-ghost-danger js-close-inspect flex-1">Cancel</button>
          <button class="btn flex-1">Record inspection</button>
        </div>
      </form>
    </dialog>
    {{else}}
    <div class="empty sm:col-span-2 lg:col-span-4">No rooms are waiting for inspection.</div>
    {{/each}}
  </div>
</section>

<section class="card overflow-x-auto p-0">
  <h2 class="section-title px-5 pt-5 sm:px-6">Recent inspections</h2>
  <table class="table">
    <thead><tr><th>When</th><th>Room</th><th>Supervisor</th><th>Result</th><th>Failed items</th><th>Remarks</th></tr></thead>
    <tbody>
      {{#each recent}}
      <tr>
        <td class="whitespace-nowrap text-moss">{{formatDate createdAt}}</td>
        <td><a href="/rooms/{{room.id}}" class="link">{{room.roomNo}}</a></td>
        <td>{{supervisor.name}}</td>
        <td>{{badge result}}</td>
        <td class="text-xs">{{#each checklist}}{{#unless passed}}<div class="text-terracotta">✗ {{this.label}}</div>{{/unless}}{{/each}}</td>
        <td>{{fallback remarks "—"}}</td>
      </tr>
      {{else}}<tr><td colspan="6" class="py-10 text-center text-moss">No inspections yet.</td></tr>{{/each}}
    </tbody>
  </table>
</section>

<script>
  document.querySelectorAll(".js-open-inspect").forEach((link) => {
    const dialog = document.getElementById(link.dataset.dialog);
    if (!dialog || typeof dialog.showModal !== "function") return; // fall back to the full page
    link.addEventListener("click", (e) => {
      e.preventDefault();
      // Lock the page behind the modal; keep the scrollbar's width so the layout doesn't shift.
      const gap = window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.overflow = "hidden";
      document.body.style.paddingRight = gap ? gap + "px" : "";
      dialog.showModal();
    });
  });

  document.querySelectorAll(".js-inspect-dialog").forEach((dialog) => {
    const form = dialog.querySelector("form");
    const boxes = [...dialog.querySelectorAll(".js-item")];
    const verdict = dialog.querySelector(".js-verdict");
    const update = () => {
      const pass = boxes.every((b) => b.checked);
      verdict.className = "js-verdict " + (pass ? "notice-ok" : "notice-danger");
      verdict.innerHTML = pass
        ? "Result: <b>PASS</b> — the room will be set to Inspected, and repairs closed."
        : "Result: <b>FAIL</b> — unticked items send the room back.";
    };
    boxes.forEach((b) => b.addEventListener("change", update));

    const close = () => dialog.close();
    dialog.querySelectorAll(".js-close-inspect").forEach((b) => b.addEventListener("click", close));
    // Click on the backdrop closes it.
    dialog.addEventListener("click", (e) => { if (e.target === dialog) close(); });
    // Start fresh next time it opens.
    dialog.addEventListener("close", () => {
      form.reset();
      update();
      document.documentElement.style.overflow = "";
      document.body.style.paddingRight = "";
    });
    form.addEventListener("submit", () => form.querySelector("button:not([type])").disabled = true);
  });
</script>
{{> footer}}
