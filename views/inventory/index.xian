{{> head}}
<div class="page-header">
  <div>
    <p class="eyebrow">Stock</p>
    <h1 class="page-title">Inventory &amp; Parts</h1>
    <p class="page-sub">{{items.length}} items · <span class="{{#if lowCount}}font-semibold text-gold-deep{{/if}}">{{lowCount}} low stock</span></p>
  </div>
</div>

{{#if canEdit}}
<form method="POST" action="/inventory" class="card mb-6 grid gap-4 sm:grid-cols-4 lg:grid-cols-8">
  <h2 class="section-title mb-0 sm:col-span-4 lg:col-span-8">Add an item</h2>
  <div><label class="label">SKU</label><input name="sku" class="input" required></div>
  <div class="lg:col-span-2"><label class="label">Name</label><input name="name" class="input" required></div>
  <div><label class="label">Category</label><input name="category" class="input" placeholder="HVAC"></div>
  <div><label class="label">Unit</label><input name="unit" class="input" value="pc"></div>
  <div><label class="label">Qty</label><input type="number" name="quantity" min="0" value="0" class="input"></div>
  <div><label class="label">Reorder at</label><input type="number" name="reorderLevel" min="0" value="0" class="input"></div>
  <div><label class="label">Unit cost ₱</label><input type="number" step="0.01" name="unitCost" min="0" value="0" class="input"></div>
  <div class="sm:col-span-3 lg:col-span-7"><label class="label">Supplier</label><input name="supplier" class="input"></div>
  <div class="flex items-end"><button class="btn w-full">Add</button></div>
</form>
{{/if}}

<div class="card overflow-x-auto p-0">
  <table class="table">
    <thead><tr><th>SKU</th><th>Item</th><th>Category</th><th class="text-right">In stock</th><th class="text-right">Reorder at</th><th class="text-right">Unit cost</th><th>Supplier</th>{{#if canEdit}}<th>Restock</th><th>Edit</th>{{/if}}</tr></thead>
    <tbody>
      {{#each items}}
      <tr class="{{#if low}}bg-gold-soft/50{{/if}}">
        <td class="whitespace-nowrap font-mono text-xs text-moss">{{sku}}</td>
        <td><b>{{name}}</b>{{#if low}} <span class="ml-1 rounded-full border border-gold/30 bg-gold-soft px-2 py-0.5 text-[11px] font-semibold text-gold-deep">Low stock</span>{{/if}}</td>
        <td>{{fallback category "—"}}</td>
        <td class="text-right tabular-nums font-semibold {{#if low}}text-gold-deep{{/if}}">{{quantity}} {{unit}}</td>
        <td class="text-right tabular-nums">{{reorderLevel}}</td>
        <td class="text-right tabular-nums">₱{{unitCost}}</td>
        <td>{{fallback supplier "—"}}</td>
        {{#if @root.canEdit}}
        <td>
          <form method="POST" action="/inventory/{{id}}/restock" class="flex gap-1">
            <input type="number" name="qty" min="1" placeholder="+qty" class="input w-20 py-1" required>
            <button class="btn btn-sm">Add</button>
          </form>
        </td>
        <td>
          <details>
            <summary class="btn-secondary btn-sm cursor-pointer">Edit</summary>
            <form method="POST" action="/inventory/{{id}}" class="mt-2 grid w-64 gap-2 rounded-xl border border-line bg-ivory p-3">
              <input type="hidden" name="sku" value="{{sku}}">
              <input name="name" value="{{name}}" class="input py-1" required>
              <input name="category" value="{{category}}" class="input py-1" placeholder="Category">
              <div class="grid grid-cols-3 gap-1">
                <input name="unit" value="{{unit}}" class="input py-1" title="Unit">
                <input type="number" name="quantity" value="{{quantity}}" min="0" class="input py-1" title="Quantity">
                <input type="number" name="reorderLevel" value="{{reorderLevel}}" min="0" class="input py-1" title="Reorder level">
              </div>
              <input type="number" step="0.01" name="unitCost" value="{{unitCost}}" min="0" class="input py-1" title="Unit cost">
              <input name="supplier" value="{{supplier}}" class="input py-1" placeholder="Supplier">
              <div class="grid grid-cols-2 gap-2">
                <button type="button" class="btn-ghost-danger btn-sm js-cancel-edit">Cancel</button>
                <button class="btn btn-sm">Save</button>
              </div>
            </form>
          </details>
        </td>
        {{/if}}
      </tr>
      {{else}}<tr><td colspan="9" class="py-10 text-center text-moss">No inventory items.</td></tr>{{/each}}
    </tbody>
  </table>
</div>
<script>
  // Cancel: discard unsaved changes and close the edit panel.
  document.querySelectorAll(".js-cancel-edit").forEach((btn) => {
    btn.addEventListener("click", () => {
      btn.form.reset();
      btn.closest("details").open = false;
    });
  });
</script>
{{> footer}}
