{{> head}}
<div class="mx-auto max-w-5xl sm:mt-4">
<a href="/" class="back-link mb-4">
  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
  Back to home
</a>
<div class="grid overflow-hidden rounded-3xl border border-line bg-white shadow-lift lg:grid-cols-[1.05fr_1fr]">
  <div class="relative hidden lg:block">
    <img src="/img/hotel-room.jpg" alt="" class="absolute inset-0 h-full w-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-t from-forest via-forest/55 to-forest/10"></div>
    <div class="relative flex h-full flex-col justify-end p-10 text-white">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#E3CFA6]">Housekeeping &amp; Maintenance</p>
      <p class="font-display text-3xl font-semibold leading-snug">From check-out to the next guest, in one place.</p>
      <p class="mt-3 max-w-sm text-sm text-white/80">Cleaning tasks, work orders, inspections and KPIs for your whole property.</p>
    </div>
  </div>
  <div class="px-6 py-10 sm:px-12 sm:py-14">
    <p class="eyebrow">RoomCare</p>
    <h1 class="font-display text-3xl font-semibold tracking-tight">Welcome back</h1>
    <p class="mt-1.5 muted">Sign in to continue to your workspace.</p>
    <form method="POST" action="/login" class="mt-8 space-y-5" autocomplete="off">
      <div>
        <label class="label" for="email">Email</label>
        <input id="email" type="email" name="email" value="" placeholder="you@hotel.com" class="input js-no-autofill" required autocomplete="off" readonly>
      </div>
      <div>
        <div class="flex items-center justify-between">
          <label class="label" for="password">Password</label>
          <a href="/forgot-password" class="mb-1.5 text-xs font-semibold text-gold hover:text-gold-deep">Forgot password?</a>
        </div>
        <input id="password" type="password" name="password" value="" placeholder="Enter your password" class="input js-no-autofill" required autocomplete="new-password" readonly data-reveal>
      </div>
      <button type="submit" class="btn w-full py-3">Sign in</button>
      <p class="border-t border-line pt-5 text-center text-sm text-moss">New to RoomCare? <a href="/register" class="link">Create an account</a></p>
    </form>
  </div>
</div>
</div>
<script>
  // Start with empty fields: browsers skip autofill on read-only inputs, so unlock each one only when the user goes to type.
  (() => {
    const fields = [...document.querySelectorAll(".js-no-autofill")];
    const unlock = (el) => el.removeAttribute("readonly");
    fields.forEach((el) => {
      ["focus", "pointerdown", "touchstart"].forEach((ev) => el.addEventListener(ev, () => unlock(el)));
    });
    const clear = () => fields.forEach((el) => { if (el.hasAttribute("readonly")) el.value = ""; });
    window.addEventListener("pageshow", clear);
    setTimeout(clear, 300);
    // Read-only inputs skip "required" checks, so unlock them before the browser validates the form.
    document.querySelector('form[action="/login"] button[type="submit"]')
      .addEventListener("click", () => fields.forEach(unlock));
  })();
</script>
{{> passwordToggle}}
{{> footer}}
