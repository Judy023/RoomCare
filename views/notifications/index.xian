{{> head}}
<div class="page-header">
  <div>
    <p class="eyebrow">Inbox</p>
    <h1 class="page-title">Notifications</h1>
    <p class="page-sub">{{unreadCount}} unread</p>
  </div>
  {{#if unreadCount}}
  <form method="POST" action="/notifications/read-all"><button class="btn-secondary btn-sm">Mark all as read</button></form>
  {{/if}}
</div>

<div class="card divide-y divide-line overflow-hidden p-0">
  {{#each notifications}}
  <form method="POST" action="/notifications/{{id}}/open" class="block">
    <input type="hidden" name="link" value="{{link}}">
    <button class="flex w-full items-start gap-4 px-5 py-4 text-left transition hover:bg-ivory sm:px-6 {{#unless isRead}}bg-sage/50{{/unless}}">
      <span class="mt-2 h-2 w-2 shrink-0 rounded-full {{#if isRead}}bg-line{{else}}bg-gold ring-4 ring-gold/15{{/if}}"></span>
      <span class="flex-1">
        <span class="flex flex-wrap items-center gap-2">
          <span class="font-semibold {{#if isRead}}text-moss{{/if}}">{{title}}</span>{{badge channel}}
        </span>
        <span class="mt-0.5 block text-sm text-moss">{{message}}</span>
      </span>
      <span class="shrink-0 text-xs text-moss/70">{{timeAgo createdAt}}</span>
    </button>
  </form>
  {{else}}
  <p class="px-5 py-12 text-center text-sm text-moss">You are all caught up. No notifications yet.</p>
  {{/each}}
</div>
{{> footer}}
