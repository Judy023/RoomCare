{{> head}}
<a href="/rooms" class="back-link">← Room board</a>
{{#if room.archivedAt}}<p class="mt-3 rounded-xl border border-gold/40 bg-gold-soft/50 p-3 text-sm text-gold-deep"><b>Archived.</b> FrontDeskFlow deleted this room on {{formatDate room.archivedAt}}. Its history is kept; it is not offered for new tasks or work orders.</p>{{/if}}
<div class="page-header mt-3">
  <div>
    <h1 class="page-title flex flex-wrap items-center gap-3">Room {{room.roomNo}} {{roomBadge room.status}}</h1>
    <p class="page-sub">{{room.type}} · Floor {{room.floor}}{{#if room.notes}} · {{room.notes}}{{/if}}{{#if room.externalId}} · FrontDeskFlow ID <span class="font-mono text-xs">{{room.externalId}}</span>{{#if room.externalSyncedAt}} · synced {{formatDate room.externalSyncedAt}}{{/if}}{{else}} · <span class="text-gold-deep">not synchronized</span>{{/if}}{{#if room.pmsStatus}} · PMS: <b>{{label room.pmsStatus}}</b> <span class="text-xs">({{formatDate room.pmsStatusAt}})</span>{{/if}}</p>
  </div>
  <div class="flex flex-wrap gap-2">
    {{#if canCheckInOut}}
      {{#if (eq room.status "OCCUPIED")}}<form method="POST" action="/rooms/{{room.id}}/checkout"><button class="btn-secondary">Check out guest</button></form>{{/if}}
    {{/if}}
    {{#if canAssign}}<a href="/tasks?roomId={{room.id}}" data-room-id="{{room.id}}" data-room="Room {{room.roomNo}} · {{room.type}} · Floor {{room.floor}}" {{#if reassign}}data-room-note="Currently with {{#each room.tasks}}{{#if (eq status 'PENDING')}}{{housekeeper.name}} ({{code}}){{/if}}{{/each}} — pick the new housekeeper."{{/if}} class="btn-secondary js-assign">{{#if reassign}}Reassign task{{else}}Assign task{{/if}}</a>{{/if}}
    {{#if canInspect}}<a href="/inspections/new?roomId={{room.id}}" class="btn js-inspect">Inspect room</a>{{/if}}  </div>
</div>

<div class="grid gap-5 lg:grid-cols-2">
  <section class="card overflow-x-auto p-0">
    <h2 class="section-title px-5 pt-5 sm:px-6">Cleaning tasks</h2>
    <table class="table">
      <thead><tr><th>Code</th><th>Task</th><th>Housekeeper</th><th>Status</th><th>Done</th></tr></thead>
      <tbody>
        {{#each room.tasks}}
        <tr><td class="whitespace-nowrap">{{code}}</td><td>{{title}} {{priorityBadge priority}}</td><td>{{fallback housekeeper.name "Unassigned"}}</td><td>{{taskBadge this}}</td><td class="whitespace-nowrap">{{formatDate completedAt}}</td></tr>
        {{else}}<tr><td colspan="5" class="py-8 text-center text-moss">No tasks yet.</td></tr>{{/each}}
      </tbody>
    </table>
  </section>

  <section class="card overflow-x-auto p-0">
    <h2 class="section-title px-5 pt-5 sm:px-6">Work orders</h2>
    <table class="table">
      <thead><tr><th>Code</th><th>Issue</th><th>Technician</th><th>Status</th></tr></thead>
      <tbody>
        {{#each room.workOrders}}
        <tr><td><a href="/work-orders/{{id}}" class="link">{{code}}</a></td><td>{{category}} — {{description}}</td><td>{{fallback assignedTo.name "—"}}</td><td>{{badge status}}</td></tr>
        {{else}}<tr><td colspan="4" class="py-8 text-center text-moss">No work orders.</td></tr>{{/each}}
      </tbody>
    </table>
  </section>

  <section class="card overflow-x-auto p-0 lg:col-span-2">
    <h2 class="section-title px-5 pt-5 sm:px-6">Inspections</h2>
    <table class="table">
      <thead><tr><th>Date</th><th>Inspected by</th><th>Result</th><th>Remarks</th></tr></thead>
      <tbody>
        {{#each room.inspections}}
        <tr><td class="whitespace-nowrap">{{formatDate createdAt}}</td><td>{{admin.name}}</td><td>{{badge result}}</td><td>{{fallback remarks "—"}}</td></tr>
        {{else}}<tr><td colspan="4" class="py-8 text-center text-moss">Not inspected yet.</td></tr>{{/each}}
      </tbody>
    </table>
  </section>
</div>
{{> inspectDialog}}
{{#if canAssign}}{{> assignDialog}}{{/if}}
{{> footer}}
