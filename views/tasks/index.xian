{{> head}}
<div class="page-header">
  <div>
    <p class="eyebrow">Housekeeping</p>
    <h1 class="page-title">Cleaning Tasks</h1>
    <p class="page-sub">Assign rooms to housekeepers and follow every task to done.</p>
  </div>
</div>

<div class="space-y-5">
  <section class="card">
    <h2 class="section-title">Dirty rooms, not yet assigned <span class="count">{{needCleaning.length}}</span></h2>
    {{#if needCleaning.length}}
    <div class="flex flex-wrap gap-2">
      {{#each needCleaning}}
      <a href="/tasks?roomId={{id}}" data-room-id="{{id}}" data-room="Room {{roomNo}} · {{type}} · Floor {{floor}}" class="js-assign rounded-lg border border-terracotta/25 bg-terracotta-soft px-3 py-1.5 text-sm text-terracotta transition hover:border-terracotta/50 hover:shadow-soft">Room <b>{{roomNo}}</b> <span class="text-xs">· F{{floor}}</span></a>
      {{/each}}
    </div>
    {{else}}<p class="empty">All caught up.</p>{{/if}}
  </section>

  <section class="card overflow-x-auto p-0">
    <div class="flex flex-wrap items-center justify-between gap-2 px-5 pt-5 pb-4 sm:px-6">
      <h2 class="section-title mb-0">Tasks</h2>
      <form method="GET" class="flex gap-2">
        <select name="status" class="input w-auto py-1.5" onchange="this.form.submit()">
          <option value="">All statuses</option>
          {{#each statuses}}<option value="{{this}}" {{selected this @root.status}}>{{label this}}</option>{{/each}}
        </select>
      </form>
    </div>
    <table class="table">
      <thead><tr><th>Code</th><th>Room</th><th>Task</th><th>Housekeeper</th><th>Status</th><th>Assigned</th><th>Time taken</th></tr></thead>
      <tbody>
        {{#each tasks}}
        <tr>
          <td class="whitespace-nowrap font-mono text-xs text-moss">{{code}}{{#if (eq source "PMS")}}<div class="font-sans text-[11px] font-semibold text-steel">from PMS</div>{{/if}}</td>
          <td><a href="/rooms/{{room.id}}" class="link">{{room.roomNo}}</a></td>
          <td>{{title}} {{priorityBadge priority}}{{#if notes}}<div class="mt-0.5 text-xs text-moss">{{nl2br notes}}</div>{{/if}}</td>
          <td>{{#if housekeeper}}{{housekeeper.name}}{{else}}<a href="/tasks?roomId={{room.id}}" data-room-id="{{room.id}}" data-room="Room {{room.roomNo}} · {{room.type}} · Floor {{room.floor}}" class="link js-assign">Assign…</a>{{/if}}</td>
          <td>{{taskBadge this}}{{#if (eq status "DONE")}}<div class="mt-0.5 text-[11px] text-moss">pending verification</div>{{/if}}</td>
          <td class="whitespace-nowrap">{{#if housekeeper}}{{formatDate (fallback assignedAt createdAt)}}<div class="text-xs text-moss">by {{fallback admin.name "—"}}</div>{{else}}<span class="muted">not yet</span><div class="text-xs text-moss">created {{formatDate createdAt}}</div>{{/if}}</td>
          <td class="whitespace-nowrap">{{minutesBetween startedAt completedAt}}</td>
        </tr>
        {{else}}<tr><td colspan="7" class="py-10 text-center text-moss">No tasks.</td></tr>{{/each}}
      </tbody>
    </table>
  </section>
</div>
{{> assignDialog}}
{{> footer}}
