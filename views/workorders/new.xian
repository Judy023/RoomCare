{{> head}}
<div class="mx-auto max-w-xl">
  <div class="mb-6">
  <p class="eyebrow">Maintenance</p>
  <h1 class="page-title">Report a Maintenance Issue</h1>
  <p class="page-sub">The room is set to <b>Out of Order</b> and an admin is notified right away.</p>
  </div>
  <form method="POST" action="/work-orders" enctype="multipart/form-data" class="card space-y-5 sm:p-8">
    {{> reportFields p=""}}
    <button class="btn w-full py-3">Submit report</button>
  </form>
</div>
<script>
  document.querySelector(".js-photo").addEventListener("change", (e) => {
    const file = e.target.files[0];
    const img = document.querySelector(".js-photo-preview");
    if (!file) return img.classList.add("hidden");
    img.src = URL.createObjectURL(file);
    img.classList.remove("hidden");
  });
</script>
{{> footer}}
